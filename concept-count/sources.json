      "commit": "3e33a03bdaa3a89f27d5e0c390c4ba9032f14b5e",
      "note": "commit of tag 0.142.1",
      "path": "README.md",
      "block": "### Create it"
    },
    {
      "id": "django-settings",
      "label": "Django 6.1.1, settings.py generated by startproject mysite",
      "packages": [
        "django"
      ],
      "repo": "django/django",
      "commit": "249b13d6e93ee3164dee8ed1775395622a50c337",
      "note": "commit of tag 6.1.1",
      "path": "django/conf/project_template/project_name/settings.py-tpl",
      "settings": true,
      "template_vars": {
        "project_name": "mysite",
        "secret_key": "django-insecure-example-key",
        "django_version": "6.1.1",
        "docs_version": "6.1"
      }
    },
    {
